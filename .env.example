# ── Payment rails (dual-rail x402: USDC on Base *and* Solana) ───────────────
# Every paid route advertises BOTH rails in its 402 challenge; the paying
# client picks one. These are the suite's public receive addresses — the
# server runs with them out of the box. Replace them to get paid yourself.

# EVM (Base / Base Sepolia) USDC receive address
PAY_TO_ADDRESS=0x40252CFDF8B20Ed757D61ff157719F33Ec332402
# Solana USDC receive address
SOLANA_PAY_TO_ADDRESS=WwwuGbqHrwF5RG89KhUbmRWEvjnRH9k5kVM5p7T3WwW

# ── Networks ────────────────────────────────────────────────────────────────
# EVM rail: base-sepolia (testnet, default) or base (mainnet).
#NETWORK=base-sepolia
# Solana rail: mainnet-beta (default) or devnet.
#SOLANA_NETWORK=mainnet-beta
# Solana RPC used by the browser checkout helper.
#SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ── Facilitator ─────────────────────────────────────────────────────────────
# The x402 facilitator that verifies + settles payments on the EVM rail.
#FACILITATOR_URL=https://x402.org/facilitator
# Facilitator for the Solana rail. The reference x402.org facilitator only
# settles base-sepolia, so the Solana rail defaults to PayAI's public
# facilitator — no API key required.
#SOLANA_FACILITATOR_URL=https://facilitator.payai.network
# Facilitator sponsor account that pays the SOL network fee, so payers need
# only USDC (no SOL). Override if your facilitator uses a different sponsor.
#SOLANA_FEE_PAYER=2wKupLR9q6wXYppw8Gr2NvWxKBUqm4PPJKkQfoxHDBg4

# ── Server ──────────────────────────────────────────────────────────────────
# HTTP port (default 4030).
#PORT=4030
# Public base URL, used to build the absolute `resource` in 402 challenges.
# Set this when running behind a proxy or on a public host.
#PUBLIC_BASE_URL=https://registry.example.com

# ── Signing ─────────────────────────────────────────────────────────────────
# HMAC key for listing signatures. The default dev secret is printed as a
# warning at boot — set this in production, or anyone running this code can
# forge a listing that appears to come from your registry.
#SIGNING_SECRET=a-long-random-string

# ── Storage ─────────────────────────────────────────────────────────────────
# Directory holding listings.json — the whole index. Back it up.
#DATA_DIR=./data

# ── Upstream data ───────────────────────────────────────────────────────────
# None. The registry is self-contained: it stores what people register and
# serves it back. There is no fixture mode. On first boot the index is seeded
# with the x402 Suite's own services, each marked origin: "seed".

# ── Client examples only (never read by the server) ─────────────────────────
# Wallet private key used by examples/agent-client.ts to PAY for calls.
# Fund it with Base Sepolia USDC: https://faucet.circle.com
#PRIVATE_KEY=0x...
# Base URL the example client talks to.
#BASE_URL=http://localhost:4030
